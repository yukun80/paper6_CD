\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Depth-class transition matrices for CCDepth and FwDET with different extent inputs. (a)--(c) CCDepth results for Zhengzhou, Zhuozhou, and Guangxi. (d)--(f) FwDET results for the corresponding study areas. The vertical axis, Label depth, represents depth classes obtained by each method using the manually delineated reference extent; the horizontal axis, HarmoSSM depth, represents depth classes obtained using the detected extent. Each matrix uses the corresponding method's valid-depth pixels under the manually delineated reference extent as its reference domain and is row-normalized. Values and colors represent transition proportions, and diagonal entries indicate retention of the same class. Missed denotes reference-domain pixels classified as background in the detection mask. No data denotes reference-domain pixels inside the detection mask without valid depth output. Depth is in m.}}{37}{figure.caption.22}\protected@file@percent }
\newlabel{fig:two_stage_consistency}{{12}{37}{Depth-class transition matrices for CCDepth and FwDET with different extent inputs. (a)--(c) CCDepth results for Zhengzhou, Zhuozhou, and Guangxi. (d)--(f) FwDET results for the corresponding study areas. The vertical axis, Label depth, represents depth classes obtained by each method using the manually delineated reference extent; the horizontal axis, HarmoSSM depth, represents depth classes obtained using the detected extent. Each matrix uses the corresponding method's valid-depth pixels under the manually delineated reference extent as its reference domain and is row-normalized. Values and colors represent transition proportions, and diagonal entries indicate retention of the same class. Missed denotes reference-domain pixels classified as background in the detection mask. No data denotes reference-domain pixels inside the detection mask without valid depth output. Depth is in m}{figure.caption.22}{}}
